# Copy this file to terraform.tfvars and fill in your own values.

admin_cidr     = "203.0.113.5/32" # your public IP; find it with `curl -s ifconfig.me`
ssh_public_key = "ssh-ed25519 AAAA... you@example.com"
stop_secret    = "generate-with-openssl-rand--hex-32" # `openssl rand -hex 32`

# Optional overrides (defaults shown)
# aws_region              = "eu-north-1"
# name                    = "claude-signal"
# ai_instance_type        = "t3.small"
# proxy_instance_type     = "t3.small"
# ai_root_volume_size     = 20
# proxy_root_volume_size  = 20
# ai_subnet_cidr          = "172.31.130.0/24"
# proxy_subnet_cidr       = "172.31.129.0/24"
# availability_zone       = "eu-north-1a"
# squid_port              = 3128
# relay_port              = 8443
# deploy_instance_type    = "t3.micro"
# deploy_root_volume_size = 20
# deploy_subnet_cidr      = "172.31.131.0/24"
# deploy_http_port        = 8080

# Optional: single-link start via a custom domain - see README's "Custom domain"
# section. Leave both domains unset to skip this (no EIP, no ACM cert, no cost).
# web_domain      = "web.example.com"      # starts instances, auto-opens, redirects
# app_domain      = "app.example.com"      # the actual site, HTTPS via Let's Encrypt
# web_open_secret = "generate-with-openssl-rand--hex-32" # required if web_domain is set
