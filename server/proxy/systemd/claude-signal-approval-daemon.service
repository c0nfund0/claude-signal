[Unit]
Description=claude-signal: approval daemon (non-AI Squid allowlist gatekeeper)
After=network-online.target squid.service
Wants=network-online.target

[Service]
Type=simple
User=claude-signal
EnvironmentFile=/etc/claude-signal/env
ExecStart=/usr/bin/python3 /opt/claude-signal/approval_daemon.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
