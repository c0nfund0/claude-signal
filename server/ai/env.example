# Copy to /etc/claude-signal/env on the ai instance (mode 600, owned by claude-signal).
# RELAY_SECRET must be the exact same value as the proxy instance's /etc/claude-signal/env.
#
# IMPORTANT: systemd's EnvironmentFile does NOT strip inline "# comment" text after a
# value (unlike bash `source`) - keep comments on their own line.

RELAY_PORT=8443
# copy from the proxy instance
RELAY_SECRET=
# proxy instance's private IP (NOT the public one) - used by
# claude-signal-sandbox.service to set HTTPS_PROXY on the container itself at
# start, not read by claude_wrapper.py directly (Claude Code runs inside that
# container now - see server/ai/container/Containerfile - not on this host).
PROXY_PRIVATE_IP=
SQUID_PORT=3128

# WebFetch is included: it fetches locally (respects HTTPS_PROXY below), so it's
# gated by Squid same as everything else. WebSearch is deliberately excluded - it's
# server-side via Anthropic's infra and would bypass the Squid gate entirely.
# The mcp__claude-signal-url-gate__request_url_access entry is required too - MCP
# tools aren't auto-approved by acceptEdits, so without it the tool call itself gets
# denied before it ever reaches approval_daemon.
CLAUDE_ALLOWED_TOOLS=Bash,Read,Edit,Write,Glob,Grep,WebFetch,mcp__claude-signal-url-gate__request_url_access
CLAUDE_TIMEOUT_SECONDS=900
SESSION_FILE=/opt/claude-signal/session_id

# Optional - overrides the default T-X persona baked into claude_wrapper.py
# (DEFAULT_PERSONA_PROMPT). Leave unset to use that default. Purely a tone/flavor
# layer appended to the system prompt - keep any replacement's last couple of
# sentences about never letting persona degrade actual task quality/correctness,
# or coding answers can start getting worse in the name of staying in character.
# CLAUDE_PERSONA_PROMPT=

# Set by hand after running `claude setup-token` on a browser-capable machine -
# never paste the token into a chat session; SSH in and write it directly. See README.
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub Personal Access Token (repo scope) for the git bot account - same rule as
# above, set by hand over SSH, never pasted into chat. Used by the gated
# git-push/repo-create MCP tools via `claude mcp add --env`, not the container's
# general environment.
GITHUB_TOKEN=
