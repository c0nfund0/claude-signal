# Copy to /etc/claude-signal/env on the proxy instance (mode 600, owned by claude-signal).
# install.sh creates this with RELAY_SECRET auto-generated if it doesn't already exist -
# you mainly need to fill in BOT_NUMBER and ALLOWED_SENDER after Signal registration.
#
# IMPORTANT: systemd's EnvironmentFile does NOT strip inline "# comment" text after a
# value (unlike bash `source`) - it becomes part of the value. Keep comments on their
# own line, never trailing a VAR=value line.

# The dedicated number registered to signal-cli.
BOT_NUMBER=+15551234567
# Your own Signal username (Settings -> profile -> username, e.g. "yourusername.42") -
# resolved to your account UUID at startup; every other sender is ignored.
ALLOWED_SENDER_USERNAME=yourusername.42

RELAY_SECRET=
RELAY_PORT=8443
LOCAL_ADMIN_PORT=7802
BRIDGE_PORT=7801

# Unix socket exposed by the signal-cli daemon unit (claude-signal-signal-cli-daemon) -
# signal_bridge.py connects to this, not to a signal-cli binary directly.
SIGNAL_CLI_SOCKET=/run/claude-signal/signal-cli.sock
SQUID_ALLOWLIST_PATH=/etc/squid/allowed_domains.txt
ALLOWLIST_STATE_PATH=/etc/claude-signal/allowlist.json
# Comma-separated always-on domains. github.com/api.github.com are core infra for
# the gated git tools (not ad-hoc browsing targets - the git actions themselves are
# individually approval-gated already), so they're seeded like api.anthropic.com.
PERMANENT_SEED_DOMAINS=api.anthropic.com,github.com,api.github.com
# Default duration in seconds for a plain "yes <id>" (3600 = 1h).
DEFAULT_APPROVAL_SECONDS=3600

# ai instance's private IP - `terraform output ai_private_ip`
AI_PRIVATE_IP=
# `terraform output controller_url`
CONTROLLER_URL=
# must match var.stop_secret in terraform.tfvars
STOP_SECRET=
# stop both instances after this many idle seconds (1800 = 30 min)
IDLE_SECONDS=1800
