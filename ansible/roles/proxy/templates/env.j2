# Managed by Ansible - see ansible/roles/proxy/templates/env.j2. Manual edits will
# be overwritten on the next `ansible-playbook` run.

BOT_NUMBER={{ bot_number }}
ALLOWED_SENDER_USERNAME={{ allowed_sender_username }}

RELAY_SECRET={{ relay_secret }}
RELAY_PORT={{ relay_port }}
LOCAL_ADMIN_PORT={{ local_admin_port }}
BRIDGE_PORT={{ bridge_port }}

SIGNAL_CLI_BIN=/opt/signal-cli/bin/signal-cli
SQUID_ALLOWLIST_PATH=/etc/squid/allowed_domains.txt
ALLOWLIST_STATE_PATH=/etc/claude-signal/allowlist.json
PERMANENT_SEED_DOMAINS={{ permanent_seed_domains }}
DEFAULT_APPROVAL_SECONDS={{ default_approval_seconds }}

AI_PRIVATE_IP={{ ai_private_ip }}
CONTROLLER_URL={{ controller_url }}
STOP_SECRET={{ stop_secret }}
IDLE_SECONDS={{ idle_seconds }}

DEPLOY_PRIVATE_IP={{ deploy_private_ip }}
DEPLOY_RELAY_PORT={{ relay_port }}
WEB_GATE_SCRIPT=/usr/local/sbin/claude-signal-web-gate

# GitHub PAT for the c0nfund0 bot account, used by approval_daemon.py's
# /repo-create-trigger to actually create repos, once approved. Lives ONLY here now
# (not on the ai instance or in the sandbox container) - see the note at the top of
# server/ai/mcp_git_gate.py for why. Set by SSHing into this box directly, not via
# group_vars - see the "Preserve an existing on-server GITHUB_TOKEN" task in
# roles/proxy/tasks/main.yml.
GITHUB_TOKEN={{ effective_github_token | default('') }}
