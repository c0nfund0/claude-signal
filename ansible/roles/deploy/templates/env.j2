# Managed by Ansible - see ansible/roles/deploy/templates/env.j2. Manual edits will
# be overwritten on the next `ansible-playbook` run (except GITHUB_TOKEN - see the
# "Preserve an existing on-server GITHUB_TOKEN" task in roles/deploy/tasks/main.yml).

RELAY_SECRET={{ relay_secret }}
RELAY_PORT={{ relay_port }}

GITHUB_TOKEN={{ effective_github_token | default('') }}
GITHUB_ORG=c0nfund0

DEPLOY_HTTP_PORT={{ deploy_http_port }}
DEPLOY_WORKDIR=/opt/claude-signal/deploy-work
DEPLOY_STATE_FILE=/opt/claude-signal/deploy-state.json

# This instance has no route to the internet at all (see network.tf) - git clone
# and podman's base-image pulls both go through the proxy's Squid, same as the ai
# instance. Unlike apt, git and podman DO read these standard env vars natively.
HTTP_PROXY=http://{{ proxy_private_ip }}:{{ squid_port }}
HTTPS_PROXY=http://{{ proxy_private_ip }}:{{ squid_port }}
