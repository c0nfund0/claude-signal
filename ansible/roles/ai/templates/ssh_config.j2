# Managed by Ansible - see ansible/roles/ai/templates/ssh_config.j2.
# corkscrew tunnels the SSH connection through Squid via HTTP CONNECT (plain ssh
# does not read HTTPS_PROXY/HTTP_PROXY the way curl/git-over-https do) - github.com
# still has to be in the Squid allowlist for this to actually connect (it's seeded
# permanent, see permanent_seed_domains).
Host github.com
    User git
    ProxyCommand corkscrew {{ proxy_private_ip }} {{ squid_port }} %h %p
    StrictHostKeyChecking accept-new
{% if cs2_ssh_hostname is defined and cs2_ssh_hostname %}

# Optional CS2 game server integration (see README) - a separate, dedicated key from
# the github.com one above, so a leak of either key never grants the other. Gated by
# the same Squid allowlist mechanism, toggled via the "cs2 open"/"cs2 close" Signal
# commands or request_url_access - see CS2_POLICY_PROMPT in claude_wrapper.py.
Host {{ cs2_ssh_hostname }}
    User steam
    IdentityFile ~/.ssh/id_ed25519_cs2
    ProxyCommand corkscrew {{ proxy_private_ip }} {{ squid_port }} %h %p
    StrictHostKeyChecking accept-new
{% endif %}
