# Copy to group_vars/all.yml and fill in real values (gitignored - contains secrets,
# same treatment as ../terraform.tfvars).

# --- from `terraform output` (proxy_public_ip changes on every stop/start - no
#     Elastic IP, see main README - update this before each ansible-playbook run) ---
proxy_public_ip: "203.0.113.10"
proxy_private_ip: "172.31.129.xxx"
ai_private_ip: "172.31.130.xxx"
deploy_private_ip: "172.31.131.xxx"
controller_url: "https://xxxxxxxxxx.execute-api.eu-north-1.amazonaws.com/"

# --- must match variables.tf / terraform.tfvars ---
ai_subnet_cidr: "172.31.130.0/24"
deploy_subnet_cidr: "172.31.131.0/24"
relay_port: 8443
squid_port: 3128
bridge_port: 7801
local_admin_port: 7802
deploy_http_port: 8080

# --- must match var.stop_secret in ../terraform.tfvars exactly ---
stop_secret: "REPLACE_ME"

# --- shared secret between proxy and ai daemons - any long random string, must be
#     IDENTICAL on both hosts. If you already have a live deployment, copy the
#     current value from /etc/claude-signal/env on the proxy rather than generating
#     a new one, or every daemon will need restarting with mismatched secrets until
#     both sides converge. `openssl rand -hex 32` for a fresh deployment. ---
relay_secret: "REPLACE_ME"

# --- Signal ---
bot_number: "+15551234567"
allowed_sender_username: "yourusername.42"

# --- policy ---
idle_seconds: 1800
default_approval_seconds: 3600
# github.com (git-over-SSH, port 22 via Squid CONNECT) and api.github.com (repo
# creation via the REST API) are core infra for the gated git tools, not ad-hoc
# browsing targets - seeded permanent like api.anthropic.com rather than needing
# their own Signal approval (the git push/create actions are already individually
# gated; gating the underlying connectivity too would be redundant).
permanent_seed_domains: "api.anthropic.com,github.com,api.github.com"
claude_allowed_tools: "Bash,Read,Edit,Write,Glob,Grep,WebFetch,mcp__claude-signal-url-gate__request_url_access,mcp__claude-signal-git-gate__request_git_push,mcp__claude-signal-git-gate__request_repo_create"
claude_timeout_seconds: 900
# Optional - leave unset/empty to use claude_wrapper.py's built-in default persona
# (T-X, from the Terminator films). Uncomment and edit to change the character.
# claude_persona_prompt: "You are ..."

# --- voice messages (see README's "Voice messages" section) ---
# faster-whisper model size: tiny/base/small/medium/large-v3. base is the default -
# a t3.small proxy (2GB RAM) is already running signal-cli's JVM, Squid, nginx, and
# everything else here, so small/medium cost real, noticeable memory headroom.
voice_stt_model: "base"
# How long a subprocess transcribe/synthesize call may run before signal_bridge.py
# gives up on it.
voice_timeout_seconds: 120

# --- set by hand after running `claude setup-token` on a browser-capable machine -
#     see the "Claude Code auth" section in the main README. Never commit a real
#     token here even though the file is gitignored - prefer ansible-vault if you
#     want this checked in at all. ---
claude_code_oauth_token: ""

# --- GitHub Personal Access Token (classic, `repo` scope) for the dedicated git bot
#     account - same rule as the Claude token above: never commit a real value, set
#     by hand over SSH on the server itself, not pasted into chat. ---
github_token: ""

# --- Optional CS2 game server integration (see README's "CS2 game server
#     integration" section) - leave all three commented out/unset to skip it
#     entirely; nothing else in this file depends on it. ---
# cs2_private_ip: "172.31.128.xxx"          # from ../CS2Server's `terraform output`
# cs2_controller_url: "https://yyyyyyyyyy.execute-api.eu-north-1.amazonaws.com/"
# cs2_ssh_hostname: "cs2-server.internal"   # synthetic hostname, gated like any other
#                                            # Squid-allowlisted domain - not a real DNS
#                                            # name, just an /etc/hosts entry on the proxy

# --- Optional: single-link start via a custom domain (see README's "Custom domain"
#     section) - leave all three unset to skip it entirely; nothing else in this
#     file depends on it. Requires app_domain/web_open_secret to also be set as
#     web_domain/web_open_secret in ../../terraform.tfvars (web_open_secret must be
#     the IDENTICAL value in both places, same rule as relay_secret above). ---
# app_domain: "app.example.com"             # must match terraform.tfvars' app_domain
# web_open_secret: "REPLACE_ME"             # must match terraform.tfvars' web_open_secret
# letsencrypt_email: "you@example.com"      # optional - only used for Let's Encrypt
#                                            # renewal-failure notices, sent to Let's
#                                            # Encrypt when the cert is first requested.
#                                            # Leave unset/commented to register with no
#                                            # email (--register-unsafely-without-email) -
#                                            # never defaulted to anything on your behalf.
