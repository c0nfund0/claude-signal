[Unit]
Description=claude-signal: idle monitor (stops ai/deploy independently once idle, proxy once both are)
After=network-online.target claude-signal-signal-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=claude-signal
EnvironmentFile=/etc/claude-signal/env
ExecStart=/usr/bin/python3 /opt/claude-signal/idle_monitor.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
