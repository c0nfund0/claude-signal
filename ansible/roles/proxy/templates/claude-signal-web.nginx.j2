# Managed by Ansible - see ansible/roles/proxy/templates/claude-signal-web.nginx.j2.
# The actual open/closed behavior lives in the included state file, toggled by
# claude-signal-web-gate.sh.j2 (see that file for why this is the right layer for
# the gate, not the security group).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Always reachable regardless of gate state - certbot's HTTP-01 challenge for
    # app_domain's cert (see claude-signal-web-ssl.nginx.j2 and main.yml's certbot
    # task) needs this whether the site is currently open or closed.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Static picker between whatever's currently deployed - exact match, so it
    # wins over `location /` below without needing the deploy instance (or the
    # gate) to be up at all. Regenerated by approval_daemon.py after every
    # deploy/stop/remove (see its _sync_apps) - ansible only ever seeds an
    # initial version if one doesn't already exist.
    location = / {
        root /var/www/claude-signal-landing;
        try_files /index.html =404;
    }

    location / {
        # No IP/User-Agent in the log for anyone browsing the deployed app -
        # see claude-signal-nolog-format.nginx.j2. Overrides (doesn't stack
        # with) the default access_log inherited from nginx.conf, so this is
        # the ONLY record of this traffic - which is the point.
        access_log /var/log/nginx/claude-signal-web.log claude_signal_no_pii;
        include /etc/claude-signal/web_gate_state.conf;
        if ($gate_closed) {
            return 503 "closed\n";
        }
        proxy_pass http://{{ deploy_private_ip }}:{{ deploy_http_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # meltline keeps this pretty alias regardless of which port it's currently
    # assigned (see deploy_wrapper.py's dynamic allocation) - the real routing
    # lives in the generic /app/meltline/ block below, generated into apps.conf.
    location = /meltdown {
        return 301 /app/meltline/;
    }
    location = /meltdown/ {
        return 301 /app/meltline/;
    }

    # One location block per other currently-deployed app (chess-coach, at `/`
    # above, is the one hand-integrated exception) - entirely generated by
    # approval_daemon.py's _sync_apps, never hand-edited. Ansible only ever
    # seeds an empty file if one doesn't already exist.
    include /etc/claude-signal/apps.conf;
}
