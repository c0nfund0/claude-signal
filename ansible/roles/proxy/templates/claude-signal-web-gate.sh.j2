#!/usr/bin/env bash
# Managed by Ansible - see ansible/roles/proxy/templates/claude-signal-web-gate.sh.j2.
# Invoked via sudo by approval_daemon.py's /web/open and /web/close admin routes
# (open/closed), and after every deploy/stop/remove to pick up its regenerated
# app routes (reload) - never directly by anything reachable from the ai
# instance or the internet.
#
# open/closed toggles whether nginx forwards public port 80/443 to the deploy
# instance at all, or refuses with 503 - a single switch covering every app
# currently deployed (see web_gate_state.conf, included by each app's location
# block in claude-signal-web*.nginx.j2 and in approval_daemon.py's generated
# /etc/claude-signal/apps.conf). The port itself is always reachable (see the
# proxy_http_public security group rule in network.tf) - this is the same
# allow/deny-by-content model already used for outbound domains via the Squid
# allowlist, just for inbound.
set -euo pipefail

case "${1:-}" in
  open)
    echo 'set $gate_closed 0;' > /etc/claude-signal/web_gate_state.conf
    ;;
  closed)
    echo 'set $gate_closed 1;' > /etc/claude-signal/web_gate_state.conf
    ;;
  reload)
    # No gate-state change - just picks up whatever approval_daemon.py just
    # wrote to apps.conf/the landing page after a deploy/stop/remove.
    ;;
  *)
    echo "usage: $0 open|closed|reload" >&2
    exit 1
    ;;
esac

nginx -t
systemctl reload nginx
