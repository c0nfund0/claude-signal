# Managed by Ansible - see ansible/roles/ai/templates/env.j2. Manual edits will be
# overwritten on the next `ansible-playbook` run (including CLAUDE_CODE_OAUTH_TOKEN -
# set it in ansible/group_vars/all.yml, not by hand on the server).

RELAY_PORT={{ relay_port }}
RELAY_SECRET={{ relay_secret }}
# PROXY_PRIVATE_IP/SQUID_PORT are used by claude-signal-sandbox.service (sets
# HTTPS_PROXY on the container itself at start), not by claude_wrapper.py directly -
# Claude Code runs inside that container now, not on this host.
PROXY_PRIVATE_IP={{ proxy_private_ip }}
SQUID_PORT={{ squid_port }}

CLAUDE_ALLOWED_TOOLS={{ claude_allowed_tools }}
CLAUDE_TIMEOUT_SECONDS={{ claude_timeout_seconds }}
SESSION_FILE=/opt/claude-signal/session_id

# Optional CS2 game server integration (see README) - both empty/unset by default.
# Read by claude_wrapper.py to build CS2_POLICY_PROMPT; must match the Host block
# templated into this role's ssh_config.j2 (also gated on cs2_ssh_hostname).
CS2_CONTROLLER_URL={{ cs2_controller_url | default('') }}
CS2_SSH_HOSTNAME={{ cs2_ssh_hostname | default('') }}

# Empty falls back to claude_wrapper.py's built-in default persona (T-X) - see
# DEFAULT_PERSONA_PROMPT there. Set claude_persona_prompt in group_vars/all.yml to
# override it.
CLAUDE_PERSONA_PROMPT={{ claude_persona_prompt | default('') }}

CLAUDE_CODE_OAUTH_TOKEN={{ claude_code_oauth_token }}

# GITHUB_TOKEN deliberately does NOT live here (or anywhere on this host) - it now
# lives only in the proxy role's env, read by approval_daemon.py. Confirmed live
# that `claude mcp add --env GITHUB_TOKEN=...` persisted it in plaintext in
# ~/.claude.json inside the sandbox container, readable by the same `coder` user
# Claude runs as - i.e. Claude could just read its own approval-bypass credential.
# Repo creation is now a relay to approval_daemon (same pattern as deploy
# triggering) specifically so this host, the container, and Claude never see it.
