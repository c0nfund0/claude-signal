# Managed by Ansible - see ansible/roles/proxy/templates/claude-signal-web-ssl.nginx.j2.
# HTTPS counterpart to claude-signal-web.nginx.j2, only templated once a Let's
# Encrypt certificate actually exists for {{ app_domain }} (see main.yml's certbot
# task - referencing a missing cert file here would fail nginx -t). Same gated
# content as port 80, plus the auto-open trigger the web_domain Lambda calls once
# the instances are up - see approval_daemon.py's WebOpenHandler.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ app_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ app_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ app_domain }}/privkey.pem;

    # Deliberately outside the gated `location /` below - this is what lets the
    # start link open the gate in the first place. The only thing standing between
    # the open internet and this is the X-Web-Open-Secret header, checked by
    # WebOpenHandler itself (127.0.0.1-only, not reachable any other way).
    location /_claude-signal/open {
        proxy_pass http://127.0.0.1:{{ web_open_port | default(7803) }}/open;
    }

    # Static picker between whatever's currently deployed - exact match, so it
    # wins over `location /` below without needing the deploy instance (or the
    # gate) to be up at all. This is also where the start-link flow's redirect
    # (AUTO_HTML_PAGE -> /open -> https://APP_DOMAIN/) lands. Regenerated by
    # approval_daemon.py after every deploy/stop/remove (see its _sync_apps) -
    # ansible only ever seeds an initial version if one doesn't already exist.
    location = / {
        root /var/www/claude-signal-landing;
        try_files /index.html =404;
    }

    location / {
        # No IP/User-Agent in the log for anyone browsing the deployed app -
        # see claude-signal-nolog-format.nginx.j2. Overrides (doesn't stack
        # with) the default access_log inherited from nginx.conf, so this is
        # the ONLY record of this traffic - which is the point. Deliberately
        # NOT applied to /_claude-signal/open above - that's an internal
        # control endpoint, not visitor traffic, and keeping its IP in the
        # default log is a security-relevant record, not a privacy concern.
        access_log /var/log/nginx/claude-signal-web.log claude_signal_no_pii;
        include /etc/claude-signal/web_gate_state.conf;
        if ($gate_closed) {
            return 503 "closed\n";
        }
        proxy_pass http://{{ deploy_private_ip }}:{{ deploy_http_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # meltline keeps this pretty alias regardless of which port it's currently
    # assigned (see deploy_wrapper.py's dynamic allocation) - the real routing
    # lives in the generic /app/meltline/ block below, generated into apps.conf.
    location = /meltdown {
        return 301 /app/meltline/;
    }
    location = /meltdown/ {
        return 301 /app/meltline/;
    }

    # One location block per other currently-deployed app (chess-coach, at `/`
    # above, is the one hand-integrated exception) - entirely generated by
    # approval_daemon.py's _sync_apps, never hand-edited. Ansible only ever
    # seeds an empty file if one doesn't already exist.
    include /etc/claude-signal/apps.conf;
}
